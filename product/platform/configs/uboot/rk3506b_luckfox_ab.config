# U-Boot A/B (dual-slot) boot fragment for rk3506 — used by the
# lyra-ultra-w-emmc-ab board.  Mirrors the Rockchip reference
# configs/rv1126-ab.config adapted to rk3506: CONFIG_ANDROID_AB is the
# master switch; the AVB user-space libs provide slot selection
# (rk_avb_get_current_slot / rk_avb_append_part_slot) and the
# root=PARTUUID bootargs injection for the booted system_a/system_b slot.
# No vbmeta key verification is configured, so A/B metadata works without a
# signed chain of trust.  CONFIG_SPL_AB=y and CONFIG_BOOTDELAY=0 already come
# from rk3506_luckfox_defconfig.
CONFIG_BASE_DEFCONFIG="rk3506_luckfox_defconfig"
CONFIG_LOADER_INI="RK3506BMINIALL.ini"
CONFIG_ANDROID_AB=y
CONFIG_AVB_LIBAVB=y
CONFIG_AVB_LIBAVB_AB=y
CONFIG_AVB_LIBAVB_ATX=y
CONFIG_AVB_LIBAVB_USER=y
CONFIG_RK_AVB_LIBAVB_USER=y
# CONFIG_AVB_VBMETA_PUBLIC_KEY_VALIDATE is not set
# CONFIG_CMD_ANDROID_AB_SELECT is not set
# CONFIG_ROCKCHIP_PRELOADER_PUB_KEY is not set
