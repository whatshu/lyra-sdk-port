# U-Boot A/B + AMP fragment for rk3506 — used by the lyra-ultra-w-emmc-ab-amp
# and lyra-zero-w-spinand-ab-amp boards.
#
# This is the lyra-ultra-w-emmc-ab fragment (rk3506b_luckfox_ab.config:
# CONFIG_ANDROID_AB + the AVB user-space libs) plus the AMP symbols from
# Rockchip's reference configs/rk3506-amp.config.  Because make.sh regenerates
# the .config per fragment (the last CONFIG_BASE_DEFCONFIG wins, fragments are
# NOT cumulative), AB and AMP must live in this ONE fragment.
#
# No CONFIG_RKPARM_PARTITION on the NAND board: the loader writes a real GPT
# for TYPE:GPT parameters even on SPI NAND, so both SPL (CONFIG_SPL_EFI_PARTITION
# from rk3506_luckfox_defconfig) and u-boot proper enumerate partitions via the
# EFI driver exactly as on eMMC.
#
# CONFIG_ROCKCHIP_AMP needs CONFIG_RKIMG_BOOTLOADER + CONFIG_ROCKCHIP_SMCCC,
# both default y here.  No vbmeta key validation, so A/B works without a signed
# chain of trust.
CONFIG_BASE_DEFCONFIG="rk3506_luckfox_defconfig"
CONFIG_LOADER_INI="RK3506BMINIALL.ini"
CONFIG_ANDROID_AB=y
CONFIG_AVB_LIBAVB=y
CONFIG_AVB_LIBAVB_AB=y
CONFIG_AVB_LIBAVB_ATX=y
CONFIG_AVB_LIBAVB_USER=y
CONFIG_RK_AVB_LIBAVB_USER=y
# CONFIG_AVB_VBMETA_PUBLIC_KEY_VALIDATE is not set
# CONFIG_CMD_ANDROID_AB_SELECT is not set
# CONFIG_ROCKCHIP_PRELOADER_PUB_KEY is not set
CONFIG_AMP=y
CONFIG_ROCKCHIP_AMP=y
