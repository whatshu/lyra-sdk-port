# Vendor ARM toolchains used as-is (binary releases).
# URLs are the official Rockchip/ARM distribution; the sha256 pins are
# checked at image build time so a tampered/upstream-replaced binary fails
# loudly.  `make docker-image` will fill this in after the first download.

TOOLCHAIN_ARMHF_URL=https://armkeil.blob.core.windows.net/developer/Files/downloads/gnu-a/10.3-2021.07/binrel/gcc-arm-10.3-2021.07-x86_64-arm-none-linux-gnueabihf.tar.xz
TOOLCHAIN_ARMHF_SHA256=PLACEHOLDER

TOOLCHAIN_ARM_EABI_URL=https://armkeil.blob.core.windows.net/developer/Files/downloads/gnu-rm/10-2020q4/gcc-arm-none-eabi-10-2020-q4-major-x86_64-linux.tar.bz2
TOOLCHAIN_ARM_EABI_SHA256=PLACEHOLDER
