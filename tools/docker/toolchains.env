# Vendor ARM toolchains used as-is (binary releases), sha256 pinned.
# The armhf cross-compiler is required for u-boot/kernel/buildroot.
# The eabi (bare-metal) one is only needed for the RTOS/MCU side and is
# optional here — leave the URL empty to skip it.
#
# Canonical source is developer.arm.com / armkeil.blob.core.windows.net;
# huggingface.co mirror is faster and carries the same bytes (verified by
# the sha256 at image build time).

TOOLCHAIN_ARMHF_URL=https://huggingface.co/csukuangfj/sherpa-ncnn-toolchains/resolve/main/gcc-arm-10.3-2021.07-x86_64-arm-none-linux-gnueabihf.tar.xz
TOOLCHAIN_ARMHF_SHA256=aa074fa8371a4f73fecbd16bd62c8b1945f23289e26414794f130d6ccdf8e39c

TOOLCHAIN_ARM_EABI_URL=
TOOLCHAIN_ARM_EABI_SHA256=

# Official Luckfox pico (RV1106/RV1103) uclibc toolchain (gcc 8.3).  No
# public canonical download URL upstream — shipped as a local tarball in
# cache/toolchains/, verified against the sha256 below at image build time.
# The tarball is flat (no top-level dir); the Dockerfile extracts it into
# /opt/toolchains/arm-rockchip830-linux-uclibcgnueabihf/.
TOOLCHAIN_ROCKCHIP830_SHA256=8fe415c8716d686760ca81e498307f1fd77edf54f3840709baccce7d3cf6b5bc
